      "object_type": "P",
      "review_state": "FULL_BODY_STATIC_REVIEW_WITH_EXPLICIT_GAPS",
      "review_scope": "Body-level static contract; transitive application and called-module completeness are separate.",
      "source_definition_sha256": "3fbd5de9cd2ae17b1c3563b8ba98d28ec7ee1bf170cd7a9ddbf0cd4625debf8d",
      "purpose": "Append planned/actual receipt or shipment snapshot pairs, with retention and expiration gating.",
      "inputs_defaults": [
        "warehouse nvarchar(25), dashboardArea nvarchar(50) required; no defaults. Only two coded area selectors enter capture branches."
      ],
      "null_and_invalid_input_behavior": [
        "Missing warehouse/timezone can fail the initial helper. Non-numeric config expiration text can fail DATEADD conversion; a NULL config value uses5. A single fresh pair member does not suppress a new pair; two duplicate rows of one identifier can suppress it.",
        "NULL warehouse cannot match cache cleanup/read predicates and cannot be inserted into the NOT NULL warehouse field; the captured warehouse FK also applies."
      ],
      "output_shape": [
        "No explicit result set; early RETURN when freshness count exceeds1."
