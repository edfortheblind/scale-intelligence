          "order": 3,
          "explanation": "For detail rows with status1>=stsLimit except status1=995, shift ten-slot status/quantity history one slot right and set first-slot quantity to zero.",
          "evidence_refs": [
            "rs-batch-1809753850"
          ]
        },
