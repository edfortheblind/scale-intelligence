          {
            "line": 40,
            "text": "\t\tWI.INSTRUCTION_TYPE = N'<literal:4>' AND"
          },
          {
            "line": 41,
            "text": "\t\tWI.CONDITION <> N'<literal:5>' AND"
          },
          {
            "line": 42,
            "text": "\t\tWI.INTERNAL_NUM = @internalWorkOrderNum AND"
          },
          {
            "line": 43,
            "text": "\t\tWI.REFERENCE_ID = @putawayUnitId; "
          },
          {
            "line": 47,
            "text": "\tSELECT top 1 N'<literal:6>' AS SCALAR,"
