          {
            "line": 12,
            "text": "AS "
          },
          {
            "line": 13,
            "text": "BEGIN"
          },
          {
            "line": 15,
            "text": "\tDECLARE @internalWorkOrderNum as INT"
          },
          {
            "line": 16,
            "text": "\tSELECT @internalWorkOrderNum = INTERNAL_WORK_ORDER_NUM FROM WORK_ORDER_PUTAWAY_UNIT WHERE PUTAWAY_UNIT_ID = @putawayUnitId"
          },
          {
            "line": 19,
            "text": "\tSELECT top 1 N'<literal:1>' AS SCALAR,"
          },
          {
            "line": 20,
            "text": "\t\tWP.INTERNAL_WORK_ORDER_NUM AS InternalWorkOrderNum,"
          },
          {
            "line": 21,
            "text": "\t\tWP.INTERNAL_PUTAWAY_NUM AS InternalPutawayNum,"
          },
          {
            "line": 22,
            "text": "\t\tWP.PUTAWAY_UNIT_ID AS LicensePlate,"
          },
          {
            "line": 23,
            "text": "\t\tWP.ITEM AS Item,"
          },
          {
            "line": 24,
            "text": "\t\tWP.COMPANY AS Company,"
          },
          {
            "line": 25,
            "text": "\t\tWP.WAREHOUSE AS Warehouse,"
          },
          {
            "line": 26,
            "text": "\t\ti.WEB_THUMBNAIL_IMG AS WebThumbnailImage"
          },
          {
            "line": 27,
            "text": "\tFROM WORK_ORDER_PUTAWAY_UNIT WP"
          },
          {
            "line": 28,
            "text": "\tLEFT OUTER JOIN ITEM i "
          },
          {
            "line": 29,
            "text": "\t\ton (WP.ITEM = i.ITEM AND (WP.COMPANY = i.COMPANY OR (WP.COMPANY IS NULL AND i.COMPANY IS NULL)))"
          },
          {
            "line": 30,
            "text": "\tWHERE WP.PUTAWAY_UNIT_ID = @putawayUnitId;"
          },
          {
            "line": 34,
            "text": "\tSELECT top 1 N'<literal:2>' AS SCALAR,"
          },
          {
            "line": 35,
            "text": "\t\tCOUNT(WI.INTERNAL_INSTRUCTION_NUM) AS OpenWorkCount"
          },
          {
            "line": 36,
            "text": "\tFROM "
          },
          {
            "line": 37,
            "text": "\tWORK_INSTRUCTION WI"
          },
          {
            "line": 38,
            "text": "\tWHERE"
          },
          {
            "line": 39,
            "text": "\t\tWI.INTERNAL_NUM_TYPE = N'<literal:3>'AND"
