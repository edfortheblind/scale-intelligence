      "source_definition_sha256": "8a771c5ab2b07268d2af4418cf49865773de9f976133456e05fe8b3192abbbcf",
      "purpose": "Initialize or refresh the shipping dashboard cache identifier set.",
      "inputs_defaults": [
        "warehouse nvarchar(25), todaysDateWithWarehouseOffset nvarchar(50), todaysDate datetime required; no defaults. Supplied dates are trusted and not recomputed or cross-validated."
      ],
      "null_and_invalid_input_behavior": [
        "Missing system configuration leaves the expiration variable NULL and explicit insertion bypasses the column default5; captured EXPIRATION_TIME NOT NULL can reject the insert after deletion. Duplicate config matches assign an unordered value; nonnumeric text can fail conversion.",
        "A NULL helper result conflicts with VALUE NOT NULL. NULL/invalid supplied dates are not defaulted; scalar date conversions may error, and NULL stale comparisons do not match. NULL warehouse cannot match rows and cannot satisfy required warehouse insertion.",
        "At exactly expiration equality, < is false and no stale match occurs. Negative configured expiration can make newly dated rows immediately eligible; no range validation is coded."
      ],
      "output_shape": [
        "No explicit result set, key return or application status; persistent cache rows are the effect."
      ],
