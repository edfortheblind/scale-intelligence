      "ordered_branches": [
        {
          "order": 1,
          "explanation": "Count DISTINCT IDENTIFIER for warehouse in[270, 280, 290, 300, 310, 320, 330, 480, 490, 500, 510, 520, 350, 530, 720]; exactly15 means the required identifier set exists. Duplicate rows per identifier are not rejected.",
          "evidence_refs": [
            "pbm-batch-1564180968"
          ]
        },
        {
          "order": 2,
          "explanation": "If incomplete, DELETE all listed cache IDs for the warehouse; retrieve expiration configuration and INSERT one row per listed identifier, calling DASHFn_GetKPIValue for each. Two system values: shipment expiration-config40 for270,280,290,350,300,310,320,330; order config60 for480,490,500,510,520,530,720. Initialization follows that order.",
          "evidence_refs": [
            "pbm-batch-1564180968"
          ]
        },
        {
          "order": 3,
