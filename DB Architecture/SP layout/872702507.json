            "line": 20,
            "text": "\tSELECT TOP 1 @internalShipmentNum=INTERNAL_SHIPMENT_NUM "
          },
          {
            "line": 21,
            "text": "\tFROM SHIPPING_CONTAINER WHERE CONTAINER_ID=@ContainerId;"
          },
          {
            "line": 23,
            "text": " IF(@internalShipmentNum is not null)"
