            "text": "            CA.CONSOLIDATION_DOCK_LOC_AREA,"
          },
          {
            "line": 31,
            "text": "            SH.SHIP_TO AS ShipTo,"
          },
          {
            "line": 32,
            "text": "            Containers.Num_Parent_Containers AS NumOfParentContainers,"
          },
          {
            "line": 33,
            "text": "\t\t\t(SELECT COUNT(*)"
          },
          {
            "line": 34,
            "text": "\t\t\t\tFROM SHIPPING_CONTAINER SC"
          },
          {
            "line": 35,
            "text": "\t\t\t\tWHERE SC.INTERNAL_SHIPMENT_NUM = SH.INTERNAL_SHIPMENT_NUM"
          },
          {
            "line": 36,
            "text": "\t\t\t\tAND SC.warehouse = SH.warehouse"
          },
          {
            "line": 37,
            "text": "\t\t\t\tAND SC.STATUS > 400 AND PARENT is null) AS CurrentContainerCount"
          },
