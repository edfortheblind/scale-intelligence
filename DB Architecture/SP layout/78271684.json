      "source_structure": {
        "declaration": "CREATE PROCEDURE TpmOrderContainerStatus_InsightDetailPaneData( @internalContainerNum numeric(9), @culture nvarchar(10) ) AS",
        "program": [
          {
            "line": 9,
            "text": "CREATE PROCEDURE TpmOrderContainerStatus_InsightDetailPaneData("
          },
          {
            "line": 10,
            "text": "@internalContainerNum numeric(9),"
          },
          {
            "line": 11,
            "text": "@culture nvarchar(10)"
          },
          {
            "line": 13,
            "text": ")  "
          },
          {
            "line": 14,
            "text": "AS "
          },
          {
            "line": 15,
            "text": "BEGIN"
          },
          {
            "line": 17,
            "text": "SELECT N'<literal:1>' AS SCALAR,   "
          },
          {
            "line": 18,
            "text": "    sc.CONTAINER_ID as ID,  "
          },
          {
            "line": 19,
            "text": "    dbo.STSfn_RtrvStsName(N'<literal:2>' ,sc.STATUS) AS Status,        "
          },
          {
            "line": 20,
            "text": "    sc.ITEM as Item,      "
          },
          {
            "line": 21,
            "text": "    i.WEB_THUMBNAIL_IMG AS      WebThumbnailImage,  "
          },
          {
            "line": 22,
            "text": "    sc.Internal_Container_Num as InternalContainerNumber     "
          },
          {
            "line": 23,
            "text": "       FROM SHIPPING_CONTAINER sc "
          },
          {
            "line": 25,
            "text": "    left outer join LOT l ON SC.ITEM = l.ITEM AND SC.LOT = l.LOT AND ((SC.COMPANY IS NULL AND l.COMPANY IS NULL) OR SC.COMPANY = l.COMPANY)         "
          },
          {
            "line": 26,
            "text": "    LEFT OUTER JOIN ITEM i  "
          },
          {
            "line": 27,
            "text": "    ON (sc.ITEM = i.ITEM AND (sc.COMPANY = i.COMPANY OR (sc.COMPANY IS NULL AND i.COMPANY IS NULL)))  "
          },
          {
            "line": 28,
            "text": "       WHERE sc.Internal_Container_num =@internalContainerNum  "
          },
          {
            "line": 30,
            "text": "  ;WITH NestedContainerTreeList AS(  "
          },
          {
            "line": 31,
            "text": "        SELECT  INTERNAL_CONTAINER_NUM, PARENT  "
          },
          {
            "line": 32,
            "text": "        FROM    SHIPPING_CONTAINER  "
          },
          {
            "line": 33,
            "text": "        WHERE   INTERNAL_CONTAINER_NUM = @internalContainerNum   "
          },
          {
            "line": 34,
            "text": "        UNION ALL  "
          },
          {
            "line": 35,
            "text": "        SELECT  c.INTERNAL_CONTAINER_NUM, c.PARENT  "
          },
          {
            "line": 36,
            "text": "        FROM    SHIPPING_CONTAINER c INNER JOIN  "
          },
          {
            "line": 37,
            "text": "                NestedContainerTreeList t ON c.PARENT = t.INTERNAL_CONTAINER_NUM)  "
          },
          {
            "line": 40,
            "text": "SELECT N'<literal:3>' AS SCALAR,   "
          },
          {
            "line": 41,
            "text": "  count(sc.INTERNAL_CONTAINER_NUM) AS ChildContainerCount  "
          },
          {
            "line": 42,
            "text": "  FROM SHIPPING_CONTAINER sc "
          },
          {
            "line": 43,
            "text": "  WHERE sc.PARENT = @internalContainerNum  "
          },
          {
            "line": 44,
            "text": "  AND SC.CONTAINER_TYPE <> N'<literal:4>';  "
          },
          {
            "line": 46,
            "text": "SELECT N'<literal:5>' AS SCALAR,   "
          },
          {
            "line": 47,
            "text": "  count(sc.INTERNAL_CONTAINER_NUM) AS ContentsCount  "
          },
          {
            "line": 48,
            "text": "  FROM SHIPPING_CONTAINER sc "
          },
          {
            "line": 49,
            "text": "  WHERE sc.PARENT = @internalContainerNum  "
          },
          {
            "line": 50,
            "text": "  AND SC.CONTAINER_TYPE = N'<literal:6>';  "
          },
          {
            "line": 52,
            "text": "END"
