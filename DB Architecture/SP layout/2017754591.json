      "source_structure": {
        "program": [
          {
            "line": 9,
            "text": "CREATE PROCEDURE SRC_SystemDirectedWorkConfiguratorModel("
          },
          {
            "line": 10,
            "text": "@userName nvarchar(30),"
          },
          {
            "line": 11,
            "text": "@culture nvarchar(10),"
          },
          {
            "line": 12,
            "text": "@workProfileName nvarchar(25),"
          },
          {
            "line": 13,
            "text": "@workProfileSequence numeric(5),"
          },
          {
            "line": 14,
            "text": "@fromLocation nvarchar(25),"
          },
          {
            "line": 15,
            "text": "@warehouse nvarchar(25))"
          },
          {
            "line": 16,
            "text": "AS"
          },
          {
            "line": 17,
            "text": "SET NOCOUNT ON;"
          },
          {
            "line": 19,
            "text": "declare @allowWorkSelectionOnSystemDirectedWork nvarchar(25);"
          },
          {
            "line": 20,
            "text": "declare @locationClass nvarchar(25);"
          },
          {
            "line": 22,
            "text": "select"
          },
          {
            "line": 23,
            "text": "@allowWorkSelectionOnSystemDirectedWork = ALLOW_WORK_SELECT_ON_SYS_DIR"
          },
          {
            "line": 24,
            "text": ",@locationClass = LOCATION_CLASS"
          },
          {
            "line": 25,
            "text": "from Location where LOCATION = @fromLocation and warehouse =@warehouse;"
          },
          {
            "line": 27,
            "text": "select top 1"
          },
          {
            "line": 28,
            "text": "case when (ASSIGN_MULTIPLE_WORK_UNITS = N'<literal:1>') then N'<literal:2>' else N'<literal:3>' end as AssignMultipleWorkUnits,"
          },
          {
            "line": 29,
            "text": "case when (WORK_UNIT_RENAME_ENABLED =N'<literal:4>')  then N'<literal:5>' else N'<literal:6>' end as DisplayNewWorkUnitField,"
          },
          {
            "line": 30,
            "text": "case when (@allowWorkSelectionOnSystemDirectedWork = N'<literal:7>' AND WORK_UNIT_RENAME_ENABLED =N'<literal:8>') then N'<literal:9>' else N'<literal:10>' end as AllowWorkSelectionOnSystemDirectedWork,"
          },
          {
            "line": 31,
            "text": "case when (@allowWorkSelectionOnSystemDirectedWork = N'<literal:11>') then N'<literal:12>' else N'<literal:13>' end as ContinueToNextFlowForNewWorkUnitEntry,"
          },
          {
            "line": 32,
            "text": "case when (WORK_UNIT_RENAME_ENABLED =N'<literal:14>')  then N'<literal:15>'"
          },
          {
            "line": 33,
            "text": "else N'<literal:16>' end as uri,"
          },
          {
            "line": 34,
            "text": "@userName as UserName,"
          },
          {
            "line": 35,
            "text": "@culture as Culture,"
          },
          {
            "line": 36,
            "text": "@locationClass as LocationClass,"
          },
          {
            "line": 37,
            "text": "case when (WORK_UNIT_RENAME_ENABLED = N'<literal:17>') then N'<literal:18>' else N'<literal:19>' end as NewWorkUnitEntryTitle"
          },
          {
            "line": 38,
            "text": "from WORK_PROFILE_DETAIL"
          },
          {
            "line": 39,
            "text": "where WORK_PROFILE=@workProfileName and SEQUENCE=@workProfileSequence;"
          }
        ],
