      "source_structure": {
        "program": [
          {
            "line": 2,
            "text": "CREATE PROCEDURE WRK_BuildCart("
          },
          {
            "line": 3,
            "text": "@workProfile nvarchar(25),"
          },
          {
            "line": 4,
            "text": "@warehouse nvarchar(25),"
          },
          {
            "line": 5,
            "text": "@groupNumber nvarchar(50),"
          },
          {
            "line": 6,
            "text": "@cartSpots integer,"
          },
          {
            "line": 7,
            "text": "@workprofileSequence numeric(5))"
          },
          {
            "line": 8,
            "text": "AS"
          },
          {
            "line": 10,
            "text": "BEGIN"
          },
          {
            "line": 12,
            "text": "Declare @workTypes nvarchar(2000)"
          },
          {
            "line": 13,
            "text": "Declare @temp_work_types TABLE (work_type nvarchar(100))"
          },
          {
            "line": 15,
            "text": "Select @workTypes = WORK_TYPES from WORK_PROFILE_DETAIL where WORK_PROFILE = @workProfile and SEQUENCE = @workprofileSequence"
          },
          {
            "line": 17,
            "text": "Insert into @temp_work_types"
          },
          {
            "line": 18,
            "text": "Select value from STRING_SPLIT(@workTypes, N'<literal:1>') ;"
          },
          {
            "line": 20,
            "text": "BEGIN TRANSACTION"
          },
          {
            "line": 22,
            "text": "Declare @temp_sc_table TABLE"
          },
          {
            "line": 23,
            "text": "(CONTAINER_ID nvarchar(25),"
          },
          {
            "line": 24,
            "text": "INTERNAL_CONTAINER_NUM numeric(9),"
          },
          {
            "line": 25,
            "text": "CONTAINER_TYPE nvarchar(25),"
          },
          {
            "line": 26,
            "text": "GROUP_POSITION numeric(9),"
          },
          {
            "line": 27,
            "text": "PRIORITY numeric(3),"
          },
          {
            "line": 28,
            "text": "MIN_WORK_ZONE_SEQ numeric(4),"
          },
          {
            "line": 29,
            "text": "MAX_WORK_ZONE_SEQ numeric(4),"
          },
          {
            "line": 30,
            "text": "AGING_DATE_TIME datetime"
          },
          {
            "line": 31,
            "text": ");"
          },
          {
            "line": 36,
            "text": "Insert into @temp_sc_table"
          },
          {
            "line": 37,
            "text": "(CONTAINER_ID, INTERNAL_CONTAINER_NUM, CONTAINER_TYPE, GROUP_POSITION, PRIORITY,"
          },
          {
            "line": 38,
            "text": "MIN_WORK_ZONE_SEQ, MAX_WORK_ZONE_SEQ, AGING_DATE_TIME)"
          },
          {
            "line": 39,
            "text": "select"
          },
          {
            "line": 40,
            "text": "DISTINCT TOP (@cartSpots) sc.CONTAINER_ID, sc.INTERNAL_CONTAINER_NUM, sc.CONTAINER_TYPE, sc.GROUP_POSITION,"
          },
          {
            "line": 41,
            "text": "detail.PRIORITY, header.MIN_WORK_ZONE_SEQ, header.MAX_WORK_ZONE_SEQ, detail.AGING_DATE_TIME"
          },
          {
            "line": 42,
            "text": "from WORK_INSTRUCTION detail"
          },
          {
            "line": 43,
            "text": "INNER JOIN WORK_INSTRUCTION header on detail.PARENT_INSTR = header.INTERNAL_INSTRUCTION_NUM"
          },
          {
            "line": 44,
            "text": "INNER JOIN SHIPPING_CONTAINER sc with (updlock) on sc.CONTAINER_ID = detail.TRANSPORT_CONT_ID"
          },
          {
            "line": 45,
            "text": "where"
          },
          {
            "line": 46,
            "text": "detail.INTERNAL_NUM_TYPE = N'<literal:2>' and detail.FROM_WHS = @warehouse"
          },
          {
            "line": 47,
            "text": "and header.MIN_WORK_ZONE_SEQ is not null and header.MAX_WORK_ZONE_SEQ is not null"
          },
          {
            "line": 48,
            "text": "and detail.GROUP_NUM is null and detail.HOLD_CODE is null"
          },
          {
            "line": 49,
            "text": "and (sc.GROUP_POSITION = 0 or sc.GROUP_POSITION is null)"
          },
          {
            "line": 50,
            "text": "and detail.WORK_TYPE in (select work_type from @temp_work_types)"
          },
          {
            "line": 51,
            "text": "ORDER BY detail.PRIORITY asc, header.MIN_WORK_ZONE_SEQ asc, header.MAX_WORK_ZONE_SEQ asc, detail.AGING_DATE_TIME asc"
          },
          {
            "line": 53,
            "text": "Declare @counter integer"
          },
          {
            "line": 54,
            "text": "Declare @counter_limit integer"
          },
          {
            "line": 55,
            "text": "Declare @container_id_temp nvarchar(25)"
          },
          {
            "line": 56,
            "text": "Declare @container_type_temp nvarchar(25)"
          },
          {
            "line": 57,
            "text": "Declare @internal_container_num_temp numeric(9)"
          },
          {
            "line": 58,
            "text": "Declare @spot_table_temp table (SPOT_ASSIGNED numeric(9,0))"
          },
          {
            "line": 60,
            "text": "Set @counter = 0"
          },
          {
            "line": 61,
            "text": "Select @counter_limit = Count(*) from @temp_sc_table"
          },
          {
            "line": 63,
            "text": "WHILE @counter < @counter_limit"
          },
          {
            "line": 64,
            "text": "BEGIN"
          },
          {
            "line": 65,
            "text": "select @container_id_temp = CONTAINER_ID, @internal_container_num_temp = INTERNAL_CONTAINER_NUM,"
          },
          {
            "line": 66,
            "text": "@container_type_temp = CONTAINER_TYPE"
          },
          {
            "line": 67,
            "text": "from @temp_sc_table"
          },
          {
            "line": 68,
            "text": "ORDER BY PRIORITY asc, MIN_WORK_ZONE_SEQ asc, MAX_WORK_ZONE_SEQ asc, AGING_DATE_TIME asc"
          },
          {
            "line": 69,
            "text": "OFFSET @counter ROWS FETCH FIRST 1 ROWS ONLY;"
          },
          {
            "line": 71,
            "text": "Set @counter = @counter + 1;"
          },
          {
            "line": 76,
            "text": "insert into @spot_table_temp exec WRK_UpdateWorkInstructionForCartPicking null, @container_id_temp, @workProfile, @groupNumber, @internal_container_num_temp, 0, 1, 0"
          },
          {
            "line": 77,
            "text": "END"
          },
          {
            "line": 79,
            "text": "COMMIT TRANSACTION"
          },
          {
            "line": 81,
            "text": "select DISTINCT sc.CONTAINER_ID, sc.CONTAINER_TYPE, sc.GROUP_POSITION"
          },
          {
            "line": 82,
            "text": "from SHIPPING_CONTAINER sc  inner join WORK_INSTRUCTION wi"
          },
          {
            "line": 83,
            "text": "on sc.CONTAINER_ID = wi.TRANSPORT_CONT_ID"
          },
          {
            "line": 84,
            "text": "where wi.GROUP_NUM = @groupNumber and wi.INSTRUCTION_TYPE = N'<literal:3>'"
          },
          {
            "line": 85,
            "text": "order by sc.GROUP_POSITION"
          },
          {
            "line": 87,
            "text": "END"
          }
        ],
        "interpretation": "Inert exact retained SQL, not executable recovery instructions.",
