      "source_structure": {
        "program": [
          {
            "line": 8,
            "text": "CREATE PROCEDURE MetaTrans_GetEmployees"
          },
          {
            "line": 9,
            "text": "@User nvarchar(30) = NULL,"
          },
          {
            "line": 10,
            "text": "@Supervisor nvarchar(30) = NULL"
          },
          {
            "line": 11,
            "text": "AS"
          },
          {
            "line": 12,
            "text": "BEGIN"
          },
          {
            "line": 13,
            "text": "SET NOCOUNT ON;"
          },
          {
            "line": 15,
            "text": "DECLARE @IsManhUser BIT;"
          },
          {
            "line": 16,
            "text": "DECLARE @IsSaaSApplication BIT;"
          },
          {
            "line": 17,
            "text": "DECLARE @IsFeatureFlagOn BIT;"
          },
          {
            "line": 20,
            "text": "SELECT @IsFeatureFlagOn ="
          },
          {
            "line": 21,
            "text": "CASE"
          },
          {
            "line": 22,
            "text": "WHEN ENABLED = N'<literal:1>' THEN 1"
          },
          {
            "line": 23,
            "text": "ELSE 0"
          },
          {
            "line": 24,
            "text": "END"
          },
          {
            "line": 25,
            "text": "FROM FEATURE_MANAGEMENT"
          },
          {
            "line": 26,
            "text": "WHERE FEATURE_NAME = N'<literal:2>'"
          },
          {
            "line": 29,
            "text": "SELECT @IsSaaSApplication ="
          },
          {
            "line": 30,
            "text": "CASE"
          },
          {
            "line": 31,
            "text": "WHEN SYSTEM_VALUE = N'<literal:3>' THEN 1"
          },
          {
            "line": 32,
            "text": "ELSE 0"
          },
          {
            "line": 33,
            "text": "END"
          },
          {
            "line": 34,
            "text": "FROM SYSTEM_CONFIG_DETAIL"
          },
          {
            "line": 35,
            "text": "WHERE RECORD_TYPE = N'<literal:4>'"
          },
          {
            "line": 36,
            "text": "AND SYS_KEY = N'<literal:5>'"
          },
          {
            "line": 39,
            "text": "SELECT @IsManhUser ="
          },
          {
            "line": 40,
            "text": "CASE"
          },
          {
            "line": 41,
            "text": "WHEN EMAIL_ADDRESS like N'<literal:6>' THEN 1"
          },
          {
            "line": 42,
            "text": "ELSE 0"
          },
          {
            "line": 43,
            "text": "END"
          },
          {
            "line": 44,
            "text": "FROM USER_PROFILE"
          },
          {
            "line": 45,
            "text": "WHERE USER_NAME = @User;"
          },
          {
            "line": 47,
            "text": "IF (@IsSaaSApplication = 1  AND @IsFeatureFlagOn = 1)"
          },
          {
            "line": 48,
            "text": "BEGIN"
          },
          {
            "line": 49,
            "text": "SELECT"
          },
          {
            "line": 50,
            "text": "up.USER_NAME AS N'<literal:7>',"
          },
          {
            "line": 51,
            "text": "up.DESCRIPTION AS N'<literal:8>',"
          },
          {
            "line": 52,
            "text": "up.DEPARTMENT As N'<literal:9>',"
          },
          {
            "line": 53,
            "text": "up.SUPERVISOR AS N'<literal:10>',"
          },
          {
            "line": 54,
            "text": "sup.DESCRIPTION AS SUPERVISOR_DESCRIPTION"
          },
          {
            "line": 55,
            "text": "FROM USER_PROFILE up"
          },
          {
            "line": 56,
            "text": "LEFT JOIN USER_PROFILE sup ON up.SUPERVISOR = sup.USER_NAME"
          },
          {
            "line": 57,
            "text": "WHERE"
          },
          {
            "line": 58,
            "text": "up.ACTIVE = N'<literal:11>'"
          },
          {
            "line": 59,
            "text": "AND"
          },
          {
            "line": 60,
            "text": "("
          },
          {
            "line": 61,
            "text": "@User IS NULL -- [comment omitted]"
          },
          {
            "line": 62,
            "text": "OR"
          },
          {
            "line": 63,
            "text": "("
          },
          {
            "line": 64,
            "text": "@IsManhUser = 1 -- [comment omitted]"
          },
          {
            "line": 65,
            "text": "OR"
          },
          {
            "line": 66,
            "text": "(@IsManhUser = 0 AND up.EMAIL_ADDRESS not like N'<literal:12>') -- [comment omitted]"
          },
          {
            "line": 67,
            "text": ")"
          },
          {
            "line": 68,
            "text": ")"
          },
          {
            "line": 69,
            "text": "AND"
          },
          {
            "line": 70,
            "text": "(@Supervisor IS NULL OR up.Supervisor = @Supervisor)"
          },
          {
            "line": 71,
            "text": "ORDER BY up.DESCRIPTION ASC;"
          },
          {
            "line": 72,
            "text": "END"
          },
          {
            "line": 73,
            "text": "ELSE"
          },
          {
            "line": 74,
            "text": "BEGIN"
          },
          {
            "line": 75,
            "text": "SELECT"
          },
          {
            "line": 76,
            "text": "up.USER_NAME AS N'<literal:13>',"
          },
          {
            "line": 77,
            "text": "up.DESCRIPTION AS N'<literal:14>',"
          },
          {
            "line": 78,
            "text": "up.DEPARTMENT As N'<literal:15>',"
          },
          {
            "line": 79,
            "text": "up.SUPERVISOR AS N'<literal:16>',"
          },
          {
            "line": 80,
            "text": "sup.DESCRIPTION AS SUPERVISOR_DESCRIPTION"
          },
          {
            "line": 81,
            "text": "FROM USER_PROFILE up"
          },
          {
            "line": 82,
            "text": "LEFT JOIN USER_PROFILE sup ON up.SUPERVISOR = sup.USER_NAME"
          },
          {
            "line": 83,
            "text": "WHERE"
          },
          {
            "line": 84,
            "text": "up.ACTIVE = N'<literal:17>'"
          },
          {
            "line": 85,
            "text": "AND"
          },
          {
            "line": 86,
            "text": "(@Supervisor IS NULL OR up.Supervisor = @Supervisor)"
          },
          {
            "line": 87,
            "text": "ORDER BY up.DESCRIPTION ASC;"
          },
          {
            "line": 88,
            "text": "END"
          },
          {
            "line": 89,
            "text": "END"
          }
        ],
