            "text": "LAT.AUTO_FILL_TYPE,"
          },
          {
            "line": 48,
            "text": "LAT.AUTO_FILL_FORMAT,"
          },
          {
            "line": 49,
            "text": "LAT.PATTERN"
          },
          {
            "line": 50,
            "text": "FROM LOT_ATTRIBUTE_TEMPLATE LAT"
