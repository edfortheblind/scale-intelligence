<?xml version="1.0" encoding="utf-8" ?>
<xs:schema id="PrintAttributes" targetNamespace="http://www.manh.com/ILSNET/Printing/PrintAttributes"
	elementFormDefault="qualified" xmlns="http://www.manh.com/ILSNET/Printing/PrintAttributes"
	xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:complexType name="PrintAttributes">
		<xs:sequence>
			<xs:element name="PrintDevice" type="xs:string" />
			<xs:element name="Template" type="xs:string" />
			<xs:element name="PrinterDriverSymbol" type="xs:string" />
			<xs:element name="PrinterStockSymbol" type="xs:string" />
			<xs:element name="NumberOfCopies" type="xs:int" />
		</xs:sequence>
	</xs:complexType>
</xs:schema>