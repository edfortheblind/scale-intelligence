<?xml version="1.0" encoding="utf-8" ?> 
<xs:schema targetNamespace="http://www.manh.com/ILSNET/Entities" xmlns:tns="http://www.manh.com/ILSNET/Entities" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="message" type="tns:Message" /> 
	<xs:element minOccurs="1" maxOccurs="1" name="links" type="tns:Link" /> 
	<xs:complexType name="Message">
		<xs:all>
			<xs:element name="message" type="xs:string" minOccurs="1" maxOccurs="1" /> 
		</xs:all>
	</xs:complexType>
	<xs:complexType name="Link">
		<xs:attribute name="href" type="xs:string" /> 
		<xs:attribute name="type" type="xs:string" /> 
		<xs:attribute name="rel" type="xs:string" /> 
	</xs:complexType>
</xs:schema>