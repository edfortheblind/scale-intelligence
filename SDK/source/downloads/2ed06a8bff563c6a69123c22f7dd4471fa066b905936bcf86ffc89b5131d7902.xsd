			<xs:element name="ManifestId" type="xs:string" minOccurs="0" maxOccurs="1" />
			<xs:element name="MSN" type="xs:int" minOccurs="0" maxOccurs="1" />
			<xs:element name="ReturnsMSN" type="xs:int" minOccurs="0" maxOccurs="1" />
			<xs:element name="TotalFreightCharge" type="xs:double" minOccurs="0" maxOccurs="1" />
			<xs:element name="ReturnsTotalFreightCharge" type="xs:double" minOccurs="0" maxOccurs="1" />
			<xs:element name="TrackingNumber" type="xs:string" minOccurs="0" maxOccurs="1" />
			<xs:element name="ReturnsTrackingNumber" type="xs:string" minOccurs="0" maxOccurs="1" />
			<xs:element name="ReturnsPrintLabel" type="xs:string" minOccurs="0" maxOccurs="1" />
			<xs:element name="ReturnsCalltagFee" type="xs:double" minOccurs="0" maxOccurs="1" />
			<xs:element name="ShippingContainerUserDefinedFields" type="import1:UserDefinedFields" maxOccurs="1" />
		</xs:sequence>
	</xs:complexType>
</xs:schema>