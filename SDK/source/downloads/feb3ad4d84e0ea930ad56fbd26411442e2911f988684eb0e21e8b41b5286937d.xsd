<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://www.manh.com/ILSNET/Shipping" xmlns:tns="http://www.manh.com/ILSNET/Shipping" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<xs:include schemaLocation="ContainerReference.xsd" />
	<xs:element name="transferShippingContainersRequest" type="tns:transferShippingContainersRequest" />
	<xs:complexType name="transferShippingContainersRequest">
		<xs:sequence>
			<xs:element minOccurs="1" maxOccurs="unbounded" name="transferShippingContainerRequest" type="tns:transferShippingContainerRequest" />
			<xs:element minOccurs="0" maxOccurs="1" name="forceReassignment" type="xs:boolean" />
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="transferShippingContainerRequest">
		<xs:all>
			<xs:element minOccurs="1" maxOccurs="1" name="containerReference" type="tns:ContainerReference" />
			<xs:element minOccurs="1" maxOccurs="1" name="location" type="xs:string" />
			<xs:element minOccurs="1" maxOccurs="1" name="warehouse" type="xs:string" />
			<xs:element minOccurs="1" maxOccurs="1" name="locationRowVersion" type="xs:long" />
			<xs:element minOccurs="0" maxOccurs="1" name="dockAreaRowVersion" type="xs:long" />
		</xs:all>
	</xs:complexType>
</xs:schema>
