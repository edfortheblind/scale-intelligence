* text=auto
.gitattributes text eol=lf
.ignore text eol=lf
*.html text eol=lf
*.css text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
AIM/source/** -text -filter -diff -merge
SDK/source/** -text -filter -diff -merge
AIM/rendered/** -text -filter -diff -merge
SDK/rendered/** -text -filter -diff -merge
AIM/reading/** -text -filter -diff -merge
SDK/reading/** -text -filter -diff -merge
*.sqlite -text -filter -diff -merge
# Supplied prompts remain exact source files.
01_AIM_MASTER_PROMPT.md -text
02_SDK_MASTER_PROMPT.md -text
# Database evidence hashes bind exact local bytes, including line endings.
"DB Architecture/**" -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Exact captured routine source retains original whitespace and line endings.
"DB Architecture/SP layout/*.sql" -text -filter -whitespace
"DB Architecture/function layout/*.sql" -text -filter -whitespace
# Owner-supplied supporting documents remain byte-preserved originals.
SDD/*.docx -text -filter -diff -merge
SDD/*.pdf -text -filter -diff -merge
SDD/*.pptx -text -filter -diff -merge
# Generated PDFs retain exact bytes even when their streams use ASCII encoding.
output/pdf/*.pdf -text -filter -diff -merge
# Derived source and review manifests bind exact bytes, including line endings.
SDD/derived/** -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Reading copies retain extracted source spacing verbatim.
SDD/derived/reading/** -whitespace
# TAB core packets bind exact bytes; reading copies preserve source spacing.
SDD/tab-core/** -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
SDD/tab-core/reading/** -whitespace
# The independent TAB review receipt binds the exact reviewed files.
_project/tab-core-reconciliation-review-20261008.json -text -filter
# Frozen independent review receipt hashes bind exact authored bytes.
_project/help-question-continuation3.json -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# C18 independent evidence retains the exact reviewed author bytes.
_project/RETRIEVAL_BROAD_REVIEW_C18.md -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
_project/RETRIEVAL_SOURCE_ASSESSMENT_C18.md -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
_project/retrieval-broad-dispositions-continuation18.json -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
_project/retrieval-context-dispositions-continuation18.json -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
_project/retrieval-semantic-dispositions-continuation18.json -text -filter whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Retired payload is byte-preserved in Git and excluded from exported packages.
archive export-ignore
archive/** -text -filter -diff -merge -whitespace export-ignore
